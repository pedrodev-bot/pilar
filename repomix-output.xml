    marginBottom: 6,
  },
  totalValue: {
    fontSize: 32,
    fontWeight: '700',
  },
  row: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    borderTopWidth: 1,
    paddingTop: 16,
  },
  col: {
    flex: 1,
    alignItems: 'center',
  },
  colTitle: {
    fontSize: 11,
