import React, { useState } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  ActivityIndicator,
  KeyboardAvoidingView,
  Platform,
  Alert,
} from 'react-native';
import { loginRequest, registerRequest } from '../../services/authService';
import { useTranslation } from 'react-i18next';

export default function LoginScreen() {
  const { t } = useTranslation();
  const [isRegistering, setIsRegistering] = useState(false);
  const [username, setUsername] = useState('');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [loading, setLoading] = useState(false);

  async function handleSubmit() {
    if ((isRegistering && !username.trim()) || !email.trim() || !password.trim()) {
      Alert.alert(t('common.attention'), t('auth.login.alerts.missingCredentials'));
      return;
    }

    try {
      setLoading(true);
      if (isRegistering) {
        await registerRequest(email.trim(), password, username.trim());
        Alert.alert("Sucesso", "Conta criada com sucesso!");
      } else {
        await loginRequest(email.trim(), password);
      }
    } catch (error: any) {
      Alert.alert(t('common.error'), error.message || t('auth.login.errors.requestFailed'));
    } finally {
      setLoading(false);
    }
  }

  const toggleMode = () => {
    setIsRegistering(!isRegistering);
    setUsername(''); 
    setPassword('');
  };

  return (
    <KeyboardAvoidingView
      behavior={Platform.OS === 'ios' ? 'padding' : undefined}
      style={styles.container}
    >
      <View style={styles.formCard}>
        <Text style={styles.brandTitle}>{t('auth.login.brandTitle')}</Text>
        <Text style={styles.subtitle}>
          {isRegistering ? t('auth.login.subtitle.register') : t('auth.login.subtitle.signIn')}
        </Text>

        {isRegistering && (
          <TextInput
            placeholder="Nome de Utilizador (ex: pedrolopes)"
            placeholderTextColor="#8E8E93"
            value={username}
            onChangeText={setUsername}
            autoCapitalize="none"
            style={styles.input}
          />
        )}

        <TextInput
          placeholder="E-mail (ex: contato@email.com)"
          placeholderTextColor="#8E8E93"
          value={email}
          onChangeText={setEmail}
          autoCapitalize="none"
          keyboardType="email-address"
          style={styles.input}
        />

        <TextInput
          placeholder={t('auth.login.placeholders.password')}
          placeholderTextColor="#8E8E93"
          value={password}
          onChangeText={setPassword}
          secureTextEntry
          style={styles.input}
        />

        <TouchableOpacity
          style={styles.button}
          onPress={handleSubmit}
          disabled={loading}
        >
          {loading ? (
            <ActivityIndicator color="#000000" />
          ) : (
            <Text style={styles.buttonText}>
              {isRegistering ? t('auth.login.buttons.registerAndSignIn') : t('auth.login.buttons.signIn')}
            </Text>
          )}
        </TouchableOpacity>

        <TouchableOpacity
          onPress={toggleMode}
          style={styles.switchButton}
        >
          <Text style={styles.switchText}>
            {isRegistering ? t('auth.login.switchMode.toLogin') : t('auth.login.switchMode.toRegister')}
          </Text>
        </TouchableOpacity>
      </View>
    </KeyboardAvoidingView>
  );
}

