import { useState } from 'react';
import { View, TextInput, TouchableOpacity, Text, StyleSheet } from 'react-native';
import { useRouter, useLocalSearchParams, Stack } from 'expo-router';
import { useTransactionStore } from '../stores/transactionStore';
import { useAuthStore } from '../stores/useAuthStore';
import { useThemeStore } from '../stores/useThemeStore';
import CurrencyInput from 'react-native-currency-input';
import { useTranslation } from 'react-i18next';


export default function NewTransactionScreen() {
  const { t, i18n } = useTranslation();
  const isPt = i18n.language.startsWith('pt');
  const router = useRouter();
  const theme = useThemeStore((state) => state.theme);
  const { type } = useLocalSearchParams();
  const addTransaction = useTransactionStore((state) => state.addTransaction);
  const currentUserId = useAuthStore((state) => state.user?.id);
  
  const [amount, setAmount] = useState<number | null>(null);
  const [description, setDescription] = useState('');

  const isExpense = type === 'expense';
  const isIncome = type === 'income';

  const txType = isExpense ? 'expense' : isIncome ? 'income' : 'investment';
  const screenTitle = t(`transactions.new.title.${txType}`);
  const placeholderText = t(`transactions.new.descriptionPlaceholder.${txType}`);
  const themeColor = isExpense ? theme.expense : isIncome ? theme.income : theme.investment;

  const handleSave = () => {
    if (!amount || !description) return;

    addTransaction({
      userId: currentUserId || '',
      amount,
      description,
      type: type as 'expense' | 'income' | 'investment',
      date: new Date().toISOString(),
    });

    router.back();
  };

return (
    <View style={[styles.container, { backgroundColor: theme.background }]}>
      <Stack.Screen
        options={{
          headerShown: true,
          title: screenTitle,
          headerTintColor: themeColor,
          headerTitleStyle: {
            fontWeight: '700',
            color: themeColor,
          },
          headerStyle: {
            backgroundColor: theme.background,
          },
          headerShadowVisible: false,
        }}
      />

      <CurrencyInput
        value={amount}
        onChangeValue={setAmount}
        prefix="R$ "
        delimiter={isPt ? '.' : ','}
        separator={isPt ? ',' : '.'}
        precision={2}
        minValue={0}
        placeholder={t('common.amountPlaceholder')}
        placeholderTextColor={theme.textMuted}
        style={[
          styles.input,
          {
            backgroundColor: theme.inputBg,
            borderColor: theme.inputBorder,
            color: theme.textPrimary,
          },
        ]}
        cursorColor={themeColor}
        selectionColor={themeColor}
      />

      <TextInput
        placeholder={placeholderText}
        placeholderTextColor={theme.textMuted}
        value={description}
        onChangeText={setDescription}
        style={[
          styles.input,
          {
            backgroundColor: theme.inputBg,
            borderColor: theme.inputBorder,
            color: theme.textPrimary,
          },
        ]}
        cursorColor={themeColor}
        selectionColor={themeColor}
      />

      <TouchableOpacity
        style={[styles.button, { backgroundColor: themeColor }]}
        onPress={handleSave}
      >
        <Text style={styles.buttonText}>{t('common.save')}</Text>
      </TouchableOpacity>
    </View>
  );
}

const styles = StyleSheet.create({
